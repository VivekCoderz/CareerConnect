{
  "name": "e2job",
  "compatibility_date": "2026-10-01",
  // Serves /sitemap.xml from the API (like the vercel.json rewrite); everything else is static.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sitemap.xml"]
  },
  "previews": {}
}
