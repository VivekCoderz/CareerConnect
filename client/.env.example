# ==============================================================================
# CareerConnect Frontend Environment Variables
# ==============================================================================
# For Vercel Deployment:
# Add these variables under Vercel Dashboard -> Project -> Settings -> Environment Variables
#
# For Local Development:
# Copy this file to .env or .env.local

# Backend API Base URL
# Local development: /api (Vite proxies to http://localhost:5001)
# Production (Render): https://your-backend-api.onrender.com/api
VITE_API_URL=/api

# Firebase Web Client Configuration (Public)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Google reCAPTCHA v3 Public Site Key
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
