# ==============================================================================
# CareerConnect Backend Environment Variables
# ==============================================================================
# In production on Render: Add these variables in the Render Dashboard -> Environment tab.
# In local development: Copy this file to .env and adjust if needed.

# Server Port (Render automatically supplies PORT, default 5000 locally)
PORT=5000

# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/CareerConnect

# JWT Secret Key for authenticating API requests
JWT_SECRET=your_jwt_secret_key_here

# Allowed Frontend Client URL(s) for CORS (supports comma-separated list)
# For Render: set to your Vercel URL and local development port
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# Optional: Session Secret for Express Session store
SESSION_SECRET=careerconnect_session_secure_key_2026
SESSION_TIMEOUT_MINUTES=15

# Email Service Configuration (Gmail App Password or SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Firebase Admin SDK (Service Account for backend verification)
FIREBASE_PROJECT_ID=career-connect-97c44
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@career-connect-97c44.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google reCAPTCHA v3 Backend Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Cloudinary Storage Configuration (for resumes, avatars, course materials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
