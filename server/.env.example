# ==============================================================================
# CareerConnect Backend Environment Variables
# ==============================================================================
# In production on Render: Add these variables in the Render Dashboard -> Environment tab.
# In local development: Copy this file to .env and adjust if needed.

# Server Port (Render automatically supplies PORT, default 5000 locally)
PORT=5001

# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=development

# Number of trusted reverse-proxy hops (for example, 1 behind a single Render proxy)
TRUST_PROXY_HOPS=0

# MongoDB Connection String (Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/careerconnect

# JWT Secret Key for authenticating API requests
JWT_SECRET=replace-with-a-long-random-secret

# Separate HMAC key for stored email verification and password reset codes
OTP_HASH_SECRET=replace-with-another-long-random-secret

# Allowed Frontend Client URL(s) for CORS (supports comma-separated list)
# For Render: set to your Vercel URL and local development port
CLIENT_URL=http://localhost:5173

# Optional: Session Secret for Express Session store
SESSION_SECRET=replace-with-a-different-long-random-secret
SESSION_TIMEOUT_MINUTES=15

# Email Service Configuration (Brevo HTTP API)
EMAIL_USER=your-email@example.com
BREVO_API_KEY=your-brevo-api-key

# Firebase Admin SDK (Service Account for backend verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Google reCAPTCHA v3 Backend Secret Key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Cloudinary Storage Configuration (for resumes, avatars, course materials)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google Gemini AI API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
